# Server
PORT=5000
NODE_ENV=development

# Database (PostgreSQL - Supabase veya yerel)
DATABASE_URL="postgresql://username:password@localhost:5432/floravita_db?schema=public"

# PayTR Test Bilgileri (test.paytr.com)
PAYTR_MERCHANT_ID=your_test_merchant_id
PAYTR_MERCHANT_KEY=your_test_merchant_key
PAYTR_MERCHANT_SALT=your_test_merchant_salt
PAYTR_SUCCESS_URL=http://localhost:3000/siparis-basarili
PAYTR_FAIL_URL=http://localhost:3000/odeme?error=1
PAYTR_NOTIFICATION_URL=http://localhost:5000/api/paytr/callback

# Frontend URL (CORS için)
FRONTEND_URL=http://localhost:3000

# JWT (ileride kullanıcı girişi için)
JWT_SECRET=floravita_super_secret_key_change_in_production
